{
  "manifest_version": 3,
  "name": "Easy Signup Assistant (Prototype)",
  "version": "0.1.0",
  "description": "Accessibility prototype: fill out one easy form once, then get help auto-filling the real Google and Instagram sign-up pages. You still click Submit and complete any verification step yourself.",
  "options_page": "options.html",
  "action": {
    "default_title": "Easy Signup Assistant",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://accounts.google.com/*"],
      "js": ["content-common.js", "content-google.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-common.js", "content-instagram.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
